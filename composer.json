{
    "name": "shekohex/wordpress-content-abilities",
    "description": "Exposes WordPress post, category, and tag abilities through the WordPress Abilities API and the official MCP Adapter.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "abilities-api",
        "mcp",
        "model-context-protocol",
        "ai",
        "content"
    ],
    "authors": [
        {
            "name": "shekohex"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.1",
        "php-stubs/wordpress-stubs": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "ContentAbilities\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContentAbilities\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "sniff": "phpcs",
        "sniff:fix": "phpcbf",
        "check": [
            "@test",
            "@analyse",
            "@sniff"
        ]
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://packagist.org"
        }
    }
}
